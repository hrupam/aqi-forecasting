# Copy to .env and fill in.  Free key: https://explore.openaq.org -> Account settings
OPENAQ_API_KEY=

# Optional overrides
# AQ_CITY=Kolkata            # default city for commands without --city (see PRESET_CITIES in config.py)
# AQ_SENSOR_ID=              # force a specific OpenAQ PM2.5 sensor (see data/raw/sensors.csv)
# AQ_TRAIN_START=2023-01-01

# Optional alert channels for alert.py
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=             # for Gmail use an App Password
# ALERT_EMAIL_TO=
